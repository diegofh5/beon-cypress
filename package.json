{
  "name": "cypress-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress API and UI tests. UI tests use page objects.",
  "scripts": {
    "cy:open": "cypress open",
    "test": "npx cypress run",
    "test:api": "cypress run --browser chrome --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:ui": "cypress run --browser chrome --spec \"cypress/e2e/ui/**/*.cy.js\"",
    "test:report": "open cypress/reports/html/index.html"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "cypress": "^16.1.1",
    "cypress-mochawesome-reporter": "^5.0.0"
  }
}
